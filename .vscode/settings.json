{
  // Help Cursor / fwcd.kotlin resolve Android + AndroidX classpath.
  "kotlin.java.home": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
  "kotlin.compiler.jvm.target": "17",
  "kotlin.languageServer.enabled": true,
  "kotlin.scripts.enabled": false,
  "kotlin.trace.server": "messages",

  "java.jdt.ls.java.home": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-17",
      "path": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
      "default": true
    }
  ],
  "java.import.gradle.enabled": true,
  "java.import.gradle.java.home": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
  "java.import.gradle.user.home": "/Volumes/2TB/gradle-home",
  "java.import.gradle.wrapper.enabled": true,

  // Cursor GUI apps often miss shell exports; pin them for terminals + tooling.
  "terminal.integrated.env.osx": {
    "JAVA_HOME": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
    "ANDROID_HOME": "/opt/homebrew/share/android-commandlinetools",
    "ANDROID_SDK_ROOT": "/opt/homebrew/share/android-commandlinetools",
    "GRADLE_USER_HOME": "/Volumes/2TB/gradle-home"
  }
}
